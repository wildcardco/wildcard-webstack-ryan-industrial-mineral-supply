---
import '../styles/global.css';
import SiteHeader from '../components/blocks/SiteHeader.astro';
import SiteFooter from '../components/blocks/SiteFooter.astro';
import MobileNav from '../components/islands/MobileNav.vue';
import { localBusinessSchema } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, jsonLd } = Astro.props;
const fullTitle = `${title} | Industrial Mineral Supply, Griffith IN`;
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [localBusinessSchema(), ...extra];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <MobileNav client:load />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
