---
/** Adapted from blocks/marketing-feature-grids-3.html */
const rows = [
  ["Paint, rust, oxidation", "Sandblasting / media blasting"],
  ["Stainless, satin finish", "Glass bead"],
  ["Aviation parts", "Plastic media"],
  ["Pipes, pumps, frames", "Zinc primer and epoxy"],
];
---

<section class="bg-white">
  <div class="mx-auto w-full max-w-6xl px-4 py-12">
    <h2 class="font-display text-3xl font-extrabold text-ink">Media by surface</h2>
    <div class="mt-6 w-full overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">Which finish fits the job</caption>
        <thead class="bg-paper text-ink">
          <tr>
            <th class="px-3 py-3 font-semibold" scope="col">Job</th>
            <th class="px-3 py-3 font-semibold" scope="col">What we use</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="border-t border-line">
                <th class="px-3 py-3 font-semibold text-ink" scope="row">{row[0]}</th>
                <td class="px-3 py-3 text-body">{row[1]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
