---
import { business } from '../../data/site';
---

<footer class="border-t border-tint bg-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
    <div class="rounded-[16px] bg-white p-4 shadow-card">
      <img
        src="/img/logo.png"
        alt="Industrial Mineral Supply"
        width="2593"
        height="1007"
        class="h-12 w-auto"
      />
      <p class="mt-3 text-sm font-semibold text-navy">{business.tagline}</p>
    </div>
    <div>
      <h2 class="text-sm font-extrabold uppercase tracking-widest text-navy">Shop</h2>
      <ul class="mt-3 space-y-2">
        <li><a class="inline-flex min-h-11 items-center font-semibold text-charcoal" href="/shop">Buy abrasives</a></li>
        <li><a class="inline-flex min-h-11 items-center font-semibold text-charcoal" href="/services">Services</a></li>
        <li><a class="inline-flex min-h-11 items-center font-semibold text-charcoal" href="/shop#policies">Shop policies</a></li>
        <li><a class="inline-flex min-h-11 items-center font-semibold text-charcoal" href="/#shop-faq">Shipping and returns</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-extrabold uppercase tracking-widest text-navy">Visit</h2>
      <p class="mt-3 text-charcoal">{business.address}</p>
      <p class="mt-2"><a class="font-bold text-navy" href={business.phoneHref}>{business.phone}</a></p>
      <p class="mt-2"><a class="font-bold text-navy" href={business.emailHref}>{business.email}</a></p>
      <p class="mt-2 text-charcoal">{business.hours}</p>
      <p class="mt-3 flex flex-wrap gap-4">
        <a class="inline-flex min-h-11 items-center font-bold text-navy" href={business.facebook}>Facebook</a>
        <a class="inline-flex min-h-11 items-center font-bold text-navy" href={business.tiktok}>TikTok</a>
      </p>
    </div>
  </div>
</footer>
