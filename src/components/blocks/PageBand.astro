---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<section class="bg-navy text-white">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h1 class="max-w-3xl text-[36px] font-extrabold leading-none tracking-tight md:text-5xl">{title}</h1>
    {lede && <p class="mt-4 max-w-xl text-white">{lede}</p>}
  </div>
</section>
