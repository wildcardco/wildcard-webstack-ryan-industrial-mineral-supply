---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="bg-navy text-white">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-accent">{eyebrow}</p>
    <h1 class="mt-2 max-w-3xl text-[36px] font-extrabold leading-none tracking-tight md:text-5xl">{title}</h1>
    {lede && <p class="mt-4 max-w-xl text-white">{lede}</p>}
  </div>
</section>
