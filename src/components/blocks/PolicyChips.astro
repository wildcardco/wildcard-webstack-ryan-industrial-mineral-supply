---
import { policyChips } from '../../data/site';
---

<section id="policies" class="bg-tint">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h2 class="text-[28px] font-extrabold tracking-tight text-navy">Shop policies</h2>
    <ul class="mt-5 flex flex-wrap gap-2">
      {
        policyChips.map((chip) => (
          <li class="rounded-full border-2 border-navy bg-white px-3 py-2 text-sm font-bold text-navy">{chip}</li>
        ))
      }
    </ul>
  </div>
</section>
