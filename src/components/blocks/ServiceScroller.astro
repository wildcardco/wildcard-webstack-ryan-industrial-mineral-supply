---
import { CircleDot, Paintbrush, Plane, Wind } from '@lucide/astro';
import { services } from '../../data/site';
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-navy">Services</p>
    <h2 class="mt-2 max-w-xl text-[28px] font-extrabold leading-tight tracking-tight text-navy md:text-4xl">
      Blasting and painting
    </h2>
    <div class="snap-row mt-8">
      {
        services.map((service) => (
          <a href={`/services#${service.id}`} class="block overflow-hidden rounded-[16px] bg-white shadow-card transition-shadow duration-200 hover:shadow-lift">
            <img
              src={service.image}
              alt={service.alt}
              width="1200"
              height="900"
              class="aspect-[4/3] w-full rounded-t-[14px] object-cover"
            />
            <div class="p-6">
              <span class="inline-flex size-11 items-center justify-center rounded-full bg-tint text-navy">
                {service.icon === 'wind' && <Wind class="size-5" aria-hidden="true" />}
                {service.icon === 'bead' && <CircleDot class="size-5" aria-hidden="true" />}
                {service.icon === 'plane' && <Plane class="size-5" aria-hidden="true" />}
                {service.icon === 'paint' && <Paintbrush class="size-5" aria-hidden="true" />}
              </span>
              <h3 class="mt-4 text-xl font-extrabold text-navy">{service.title}</h3>
              <p class="mt-2 text-charcoal">{service.copy}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
