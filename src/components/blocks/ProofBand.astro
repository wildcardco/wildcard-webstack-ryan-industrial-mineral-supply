---
const stats = [
  { value: '17+', label: 'Years of supply and service' },
  { value: '12,000 lb', label: 'Lift' },
  { value: '9,000 lb', label: 'Max load' },
  { value: '5', label: 'Blast media types' },
];
---

<section class="bg-navy text-white" aria-label="Shop proof">
  <div class="hazard-edge" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-4 py-12 md:py-16 lg:grid-cols-4">
    {
      stats.map((stat) => (
        <p class="min-w-0">
          <span class="block text-4xl font-extrabold leading-none tracking-tight text-accent md:text-5xl">{stat.value}</span>
          <span class="mt-2 block text-sm font-semibold text-white">{stat.label}</span>
        </p>
      ))
    }
  </div>
</section>
