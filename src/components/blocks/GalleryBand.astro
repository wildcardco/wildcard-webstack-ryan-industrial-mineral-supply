---
/** Adapted from blocks/marketing-cards-2.html */
import GalleryLightbox from "../islands/GalleryLightbox.vue";
import { gallery } from "../../data/site";
---

<section id="gallery" class="bg-white">
  <div class="mx-auto w-full max-w-6xl px-4 py-12">
    <h2 class="font-display text-3xl font-extrabold text-ink">Gallery</h2>
    <p class="mt-3 text-body">Shop work from Griffith. Tap a photo to open it.</p>
    <div class="mt-6">
      <GalleryLightbox client:load photos={[...gallery]} />
    </div>
  </div>
</section>
