---
import BrandButton from '../islands/BrandButton.vue';
import { business } from '../../data/site';

const links = [
  { href: '/services', label: 'Services' },
  { href: '/shop', label: 'Buy Abrasives' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-tint bg-white">
  <div class="mx-auto flex h-[4.25rem] max-w-6xl items-center gap-3 px-4">
    <a href="/" class="shrink-0">
      <img
        src="/img/logo.png"
        alt="Industrial Mineral Supply"
        width="2593"
        height="1007"
        class="h-11 w-auto max-w-[46vw] md:max-w-[220px]"
      />
    </a>
    <nav data-nav="desktop" class="ml-auto hidden items-center gap-5 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} class="inline-flex min-h-11 items-center font-bold text-navy">
            {link.label}
          </a>
        ))
      }
      <BrandButton href={business.phoneHref}>Get a quote</BrandButton>
    </nav>
  </div>
</header>
