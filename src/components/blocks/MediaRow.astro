---
import ProductCard from '../islands/ProductCard.vue';
import { categories } from '../../data/site';
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-navy">Shop</p>
        <h2 class="mt-2 text-[28px] font-extrabold leading-tight tracking-tight text-navy md:text-4xl">Blast media</h2>
      </div>
      <a href="/shop" class="inline-flex min-h-11 items-center font-extrabold text-navy underline decoration-accent decoration-2 underline-offset-4">
        All 10 products
      </a>
    </div>
    <div class="snap-row media-row mt-8">
      {
        categories.map((category) => (
          <ProductCard
            href={`/shop#${category.id}`}
            img={category.image}
            alt={category.alt}
            title={category.name}
            price={category.range}
            note={category.blurb}
          />
        ))
      }
    </div>
  </div>
</section>
