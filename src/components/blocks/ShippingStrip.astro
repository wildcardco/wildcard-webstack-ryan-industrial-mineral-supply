---
/** Adapted from blocks/marketing-sections-1.html */
import { shipping } from "../../data/site";
---

<section class="bg-paper">
  <div class="mx-auto w-full max-w-6xl px-4 py-6">
    <h1 class="font-display text-[2rem] font-extrabold text-ink">Buy abrasives</h1>
    <ul class="mt-4 grid w-full grid-cols-1 gap-3 sm:grid-cols-3">
      {
        shipping.map((line) => (
          <li class="bg-white px-3 py-3 text-ink">{line}</li>
        ))
      }
    </ul>
  </div>
</section>
