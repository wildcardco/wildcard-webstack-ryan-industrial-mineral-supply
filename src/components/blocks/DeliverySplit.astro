---
import BrandButton from '../islands/BrandButton.vue';
import { business } from '../../data/site';

const chips = ['16 ft bed', '9,000 lb load', '12,000 lb lift'];
---

<section class="bg-charcoal text-white">
  <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-12 md:grid-cols-2 md:py-20">
    <img
      src="/img/hopper.jpg"
      alt="Blasted metal hopper on the shop floor"
      width="1600"
      height="1200"
      class="aspect-[4/3] w-full rounded-[14px] object-cover shadow-lift"
    />
    <div>
      <h2 class="text-[28px] font-extrabold leading-tight tracking-tight text-white md:text-4xl">Pickup and delivery</h2>
      <p class="mt-3 max-w-md text-white">Chicagoland and Northwest Indiana.</p>
      <ul class="mt-5 space-y-2 rounded-[16px] bg-white p-4 text-navy shadow-card">
        {
          chips.map((chip) => (
            <li class="font-semibold">{chip}</li>
          ))
        }
      </ul>
      <div class="mt-6">
        <BrandButton href={business.phoneHref}>Ask about pickup</BrandButton>
      </div>
    </div>
  </div>
</section>
