---
/** Adapted from blocks/application-stats-1.html */
const stats = [
  { value: "17+", label: "Years of experience" },
  { value: "4.7", label: "Google rating, 6 reviews" },
  { value: "9,000 lb", label: "Max load" },
  { value: "2 areas", label: "Chicagoland and NW Indiana" },
];
---

<section class="on-navy bg-steel text-white" aria-label="Shop facts">
  <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-4 px-4 py-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      stats.map((stat) => (
        <p class="border border-white/30 px-4 py-4">
          <span class="block font-display text-3xl font-extrabold tabular-nums">{stat.value}</span>
          <span class="mt-1 block text-sm text-white">{stat.label}</span>
        </p>
      ))
    }
  </div>
  <p class="mx-auto w-full max-w-6xl px-4 pb-8 text-white">Over 17 years of experience.</p>
</section>
