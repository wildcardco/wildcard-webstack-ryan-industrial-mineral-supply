---
import BeforeAfterCarousel from '../islands/BeforeAfterCarousel.vue';
import PhotoLightbox from '../islands/PhotoLightbox.vue';
import { jobs } from '../../data/site';

interface Props {
  anchor?: string;
}

const { anchor = 'gallery' } = Astro.props;
---

<section id={anchor} class="bg-tint">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    <h2 class="text-[28px] font-extrabold leading-tight tracking-tight text-navy md:text-4xl">Before and after</h2>
    <div class="mt-8 md:hidden">
      <BeforeAfterCarousel client:load pictures={jobs} />
    </div>
    <div class="mt-8 hidden gap-4 md:grid md:grid-cols-4 md:auto-rows-[220px]">
      {
        jobs.map((job, index) => (
          <button
            type="button"
            data-lightbox={index}
            aria-label={`Open photo: ${job.caption}`}
            class:list={[
              'relative block h-full min-h-0 w-full overflow-hidden rounded-[14px] border-0 bg-transparent p-0 text-left shadow-card',
              index === 0 && 'md:col-span-2 md:row-span-2',
              index === 1 && 'md:col-span-2',
            ]}
          >
            <img src={job.src} alt={job.alt} width="1200" height="900" class="h-full w-full object-cover" />
            <span class="absolute inset-x-0 bottom-0 bg-navy px-3 py-2 text-sm font-semibold text-white">{job.caption}</span>
          </button>
        ))
      }
    </div>
    <PhotoLightbox client:load pictures={jobs} />
  </div>
</section>
