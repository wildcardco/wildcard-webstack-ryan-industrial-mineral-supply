---
/** Adapted from blocks/application-steps-1.html */
const steps = [
  { n: "1", title: "Request a quote", text: "Tell us the part, the media, or the job." },
  { n: "2", title: "We pick up", text: "Chicagoland and Northwest Indiana." },
  { n: "3", title: "Blast and finish", text: "Media blasting, then primer or epoxy when needed." },
  { n: "4", title: "Deliver back", text: "The finished work comes back to you." },
];
---

<section class="bg-paper">
  <div class="mx-auto w-full max-w-6xl px-4 py-12">
    <h2 class="font-display text-3xl font-extrabold text-ink">Pickup and delivery</h2>
    <p class="mt-3 text-body">16 ft bed. 9,000 lb load. 12,000 lb lift.</p>
    <ol class="mt-6 grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step) => (
          <li class="w-full bg-white p-4">
            <span class="font-display text-2xl font-extrabold text-ims tabular-nums">{step.n}</span>
            <h3 class="mt-2 font-display text-lg font-bold text-ink">{step.title}</h3>
            <p class="mt-2 text-body">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
