---
import {
  address,
  businessName,
  email,
  facebookUrl,
  hoursSummary,
  phoneDisplay,
  phoneTel,
  previewNotice,
  tiktokUrl,
} from '../data/site';
---
<footer class="border-t border-[#1f2736] bg-[#1f2736] text-white">
  <div class="mx-auto grid max-w-6xl gap-6 px-6 py-10 md:grid-cols-2">
    <div>
      <p class="font-[family-name:var(--font-heading)] text-lg font-semibold">{businessName}</p>
      <p class="mt-2">{address}</p>
      <p class="mt-2">
        <a class="text-[#edcd1f]" href={phoneTel}>{phoneDisplay}</a>
      </p>
      <p class="mt-2">
        <a class="text-[#52b4ff]" href={`mailto:${email}`}>{email}</a>
      </p>
      <p class="mt-2">{hoursSummary}</p>
    </div>
    <div>
      <p>
        <a class="text-[#52b4ff]" href={facebookUrl} rel="noopener noreferrer" target="_blank">Facebook</a>
      </p>
      <p class="mt-2">
        <a class="text-[#52b4ff]" href={tiktokUrl} rel="noopener noreferrer" target="_blank">TikTok</a>
      </p>
      <p class="mt-4">© 2026 by Industrial Mineral Supply.</p>
      <p class="mt-3 text-sm text-[#f7f7f7]">{previewNotice}</p>
    </div>
  </div>
</footer>
