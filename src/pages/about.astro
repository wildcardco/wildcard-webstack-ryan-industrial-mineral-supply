---
import Base from '../layouts/Base.astro';
import PageBand from '../components/blocks/PageBand.astro';
import { breadcrumbSchema, business } from '../data/site';

const description =
  'Over 17 years of sandblast supply and service in Griffith. Sandblasting and blast media in Griffith, IN. Call (708) 895-6070.';
---

<Base
  title="About"
  description={description}
  jsonLd={breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ])}
>
  <PageBand title="About" lede={business.tagline} />
  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-12 md:grid-cols-2 md:py-20">
      <img
        src="/img/hero.jpg"
        alt="Worker media-blasting a concrete deck outdoors"
        width="2000"
        height="1334"
        class="aspect-[4/3] w-full rounded-[14px] object-cover shadow-card"
      />
      <div>
        <h2 class="text-[28px] font-extrabold leading-tight tracking-tight text-navy md:text-4xl">Industrial Mineral Supply</h2>
        <p class="mt-4 text-charcoal">
          As an industry leader with over 17 years of experience, Industrial Mineral Supply takes pride in our quality sandblast supply and service.
        </p>
        <p class="mt-3 text-charcoal">
          The Griffith shop sandblasts, bead blasts, plastic-media blasts, and paints pipes, pumps, and frames.
        </p>
        <p class="mt-3 text-charcoal">Pickup and delivery cover Chicagoland and Northwest Indiana.</p>
      </div>
    </div>
  </section>
  <section class="bg-tint">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <h2 class="text-[28px] font-extrabold tracking-tight text-navy">Visit the shop</h2>
      <dl class="mt-5 max-w-xl space-y-3 rounded-[16px] bg-white p-6 shadow-card">
        <div>
          <dt class="font-extrabold text-navy">Address</dt>
          <dd class="text-charcoal">{business.address}</dd>
        </div>
        <div>
          <dt class="font-extrabold text-navy">Phone</dt>
          <dd><a class="font-semibold text-navy" href={business.phoneHref}>{business.phone}</a></dd>
        </div>
        <div>
          <dt class="font-extrabold text-navy">Email</dt>
          <dd><a class="font-semibold text-navy" href={business.emailHref}>{business.email}</a></dd>
        </div>
        <div>
          <dt class="font-extrabold text-navy">Hours</dt>
          <dd class="text-charcoal">{business.hours}</dd>
        </div>
        <div>
          <dt class="font-extrabold text-navy">Pickup and delivery</dt>
          <dd class="text-charcoal">16 ft bed. 9,000 lb max load. 12,000 lb lift.</dd>
        </div>
      </dl>
    </div>
  </section>
</Base>
