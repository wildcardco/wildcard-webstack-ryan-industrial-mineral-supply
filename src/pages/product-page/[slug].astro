---
import Base from "../../layouts/Base.astro";
import { business, cta, products, returnPolicy, shipping } from "../../data/site";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.path.split("/").pop() },
    props: { product },
  }));
}

const { product } = Astro.props;
const related = products.filter((item) => item.category === product.category && item.path !== product.path);
const priceNumber = product.price.replace("$", "");

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  image: product.image,
  brand: { "@type": "Brand", name: business.name },
  offers: {
    "@type": "Offer",
    priceCurrency: "USD",
    price: priceNumber,
    url: `https://www.imsblasting.com${product.path}`,
  },
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.imsblasting.com/" },
    { "@type": "ListItem", position: 2, name: "Buy Abrasives", item: "https://www.imsblasting.com/shop" },
    { "@type": "ListItem", position: 3, name: product.name, item: `https://www.imsblasting.com${product.path}` },
  ],
};

const title = `${product.name} | Industrial Mineral Supply | Griffith, IN`;
const description = `${product.name} from Industrial Mineral Supply in Griffith, IN. Call (708) 895-6070 for a quote.`;
---

<Base title={title} description={description} jsonLd={[productSchema, breadcrumb]}>
  <article class="bg-white">
    <div class="mx-auto w-full max-w-6xl px-4 py-8">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <a class="text-ink" href="/">Home</a>
        <span aria-hidden="true"> / </span>
        <a class="text-ink" href="/shop">Buy Abrasives</a>
        <span aria-hidden="true"> / </span>
        <span class="text-ink">{product.category}</span>
      </nav>

      <div class="mt-6 grid w-full grid-cols-1 gap-8 lg:grid-cols-2">
        <div class="w-full overflow-hidden bg-paper">
          <img
            src={product.image}
            alt={product.name}
            width="1000"
            height="1000"
            class="aspect-square w-full object-contain"
          />
        </div>
        <div>
          <h1 class="font-display text-[2rem] leading-tight font-extrabold text-ink">{product.name}</h1>
          <p class="mt-3 text-2xl font-bold text-ink tabular-nums">{product.price}</p>
          <p class="mt-1 text-muted">Prices exclude sales tax</p>
          <div class="mt-4 grid gap-3">
            {product.paragraphs.map((paragraph) => <p class="text-body">{paragraph}</p>)}
          </div>
          {
            product.sizes.length > 0 && (
              <div class="mt-5">
                <h2 class="font-display text-lg font-bold text-ink">{product.sizesLabel}</h2>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {product.sizes.map((size) => (
                    <li class="bg-paper px-3 py-2 text-sm font-semibold text-ink">{size}</li>
                  ))}
                </ul>
              </div>
            )
          }
          <ul class="mt-5 grid gap-2">
            {shipping.map((line) => <li class="text-body">{line}</li>)}
          </ul>
          {
            product.returns && (
              <div class="mt-5 grid gap-2">
                <h2 class="font-display text-lg font-bold text-ink">Return policy</h2>
                {returnPolicy.map((line) => <p class="text-body">{line}</p>)}
              </div>
            )
          }
          <a
            class="mt-6 inline-flex min-h-11 items-center bg-ims px-5 font-semibold text-white"
            href={`${cta.href}?item=${encodeURIComponent(product.name)}`}
          >
            {cta.label}
          </a>
        </div>
      </div>

      {
        related.length > 0 && (
          <section class="mt-12">
            <h2 class="font-display text-2xl font-bold text-ink">More {product.category}</h2>
            <ul class="mt-4 grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((item) => (
                <li>
                  <a href={item.path} class="block w-full border border-line bg-white p-4 text-ink no-underline">
                    <span class="block font-semibold">{item.name}</span>
                    <span class="mt-1 block font-bold tabular-nums">{item.price}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>
</Base>
