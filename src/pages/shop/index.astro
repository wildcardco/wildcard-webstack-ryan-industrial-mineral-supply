---
import Base from '../../layouts/Base.astro';
import ProductCards from '../../components/ProductCards.vue';
import { previewNotice, returnPolicy, shippingNote } from '../../data/site';
---
<Base title="Abrasives | Industrial Mineral Supply" description="The 10 abrasive listings from imsblasting.com. Stock unverified. No cart or checkout.">
  <main class="mx-auto max-w-6xl px-6 py-12">
    <h1 class="text-4xl font-bold">Abrasives</h1>
    <p class="mt-4 max-w-3xl text-[#3b3a3a]">
      These are the 10 abrasive listings from imsblasting.com, in the same order. There is no cart, checkout, or payment.
    </p>
    <p class="mt-4 max-w-3xl text-[#3b3a3a]">{shippingNote}</p>
    <p class="mt-4 max-w-3xl text-[#3b3a3a]">{returnPolicy[0]} Industrial Mineral Supply will correct its own errors at no charge.</p>
    <p class="mt-4 max-w-3xl text-sm text-[#3b3a3a]">{previewNotice}</p>
    <div class="mt-8">
      <ProductCards />
    </div>
  </main>
</Base>
